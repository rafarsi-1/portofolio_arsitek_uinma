# Salin ke .env.local untuk pengembangan lokal (jangan di-commit).
# Di Vercel, pasang di Project → Settings → Environment Variables.

# Dibuat otomatis saat Blob store (Public) dihubungkan ke project,
# atau ambil dengan: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=

# Password login /admin. Pakai string panjang & acak (min. 16 karakter).
ADMIN_PASSWORD=
